# Local development WITHOUT a real Firebase project:
# set this to "true" and run `npm run emulators` (Auth + Firestore + Storage).
# This makes cross-user chat and video signaling work locally. When set, the
# NEXT_PUBLIC_FIREBASE_* values below are optional (demo defaults are used).
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=
# Optional emulator host/ports (defaults: 127.0.0.1, 9099/8080/9199).
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_PORT=
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_PORT=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional web push (Cloud Messaging web config → Web Push certificates)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Enable Email/Password in Firebase Auth so chat and video signaling can sign in
# with the same demo emails (james@demo.physio / maya@demo.physio).
# Without NEXT_PUBLIC_FIREBASE_* video/chat use BroadcastChannel + localStorage
# signaling in this browser only (dev fallback) — two phones will not connect.

# Optional TURN for production NATs (server-side preferred — used by /api/ice).
# Without these, /api/ice returns Google STUN only and many cellular NATs will fail video.
TURN_URL=
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Client-side TURN fallback (also read by rtcConfig in webrtc-signaling)
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Server-only admin gate. Never prefix these with NEXT_PUBLIC_ (that would leak the UID).
# Set ADMIN_UID to the app user id (demo doctor is physio-james) or the Firebase Auth UID.
ADMIN_EMAIL=
ADMIN_UID=
ADMIN_SESSION_SECRET=
OTP_SECRET=
# Phone OTP delivery (choose one provider). Without any provider, dev shows the
# code on screen and logs it to the server console.
# Twilio: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Or a Messaging Service SID instead of TWILIO_FROM:
TWILIO_MESSAGING_SERVICE_SID=
# MSG91 (India): https://control.msg91.com/
MSG91_AUTHKEY=
MSG91_SENDER=
MSG91_ROUTE=4
PAYMENT_SIGNING_SECRET=
FIREBASE_SERVICE_ACCOUNT_JSON=
CRON_SECRET=
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=PhysioFlow <noreply@resend.dev>

# Razorpay — India (test keys from https://dashboard.razorpay.com/app/keys)
# NEXT_PUBLIC_RAZORPAY_KEY_ID is safe in the browser. Never put KEY_SECRET in NEXT_PUBLIC_*.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Server-side pricing in INR. The client total is ignored.
PAYMENT_PLATFORM_FEE_INR=49
PAYMENT_DEFAULT_FEE_INR=800
NEXT_PUBLIC_PAYMENT_PLATFORM_FEE_INR=49
