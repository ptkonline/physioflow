NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional web push (Cloud Messaging web config → Web Push certificates)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Enable Email/Password in Firebase Auth so chat and video signaling can sign in
# with the same demo emails (james@demo.physio / maya@demo.physio).
# Without NEXT_PUBLIC_FIREBASE_* video/chat use BroadcastChannel + localStorage
# signaling in this browser only (dev fallback) — two phones will not connect.

# Optional TURN for production NATs (server-side preferred — used by /api/ice).
# Without these, /api/ice returns Google STUN only and many cellular NATs will fail video.
TURN_URL=
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Client-side TURN fallback (also read by rtcConfig in webrtc-signaling)
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Server-only admin gate. Never prefix these with NEXT_PUBLIC_ (that would leak the UID).
# Set ADMIN_UID to the app user id (demo doctor is physio-james) or the Firebase Auth UID.
ADMIN_EMAIL=
ADMIN_UID=
ADMIN_SESSION_SECRET=
OTP_SECRET=
PAYMENT_SIGNING_SECRET=
FIREBASE_SERVICE_ACCOUNT_JSON=
CRON_SECRET=
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=PhysioFlow <noreply@resend.dev>

# Razorpay — India (test keys from https://dashboard.razorpay.com/app/keys)
# NEXT_PUBLIC_RAZORPAY_KEY_ID is safe in the browser. Never put KEY_SECRET in NEXT_PUBLIC_*.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Server-side pricing in INR. The client total is ignored.
PAYMENT_PLATFORM_FEE_INR=49
PAYMENT_DEFAULT_FEE_INR=800
NEXT_PUBLIC_PAYMENT_PLATFORM_FEE_INR=49
