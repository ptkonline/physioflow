rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    match /doctors_pending_verification/{allPaths=**} {
      allow write: if request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches("image/.*|application/pdf");
      allow read: if true;
    }

    match /doctors/{doctorId}/profile/{fileName} {
      allow read: if true;
      allow write: if signedIn()
        && request.auth.uid == doctorId
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
    }

    match /videos/{doctorId}/{videoId}/{fileName} {
      allow read: if true;
      allow write: if signedIn()
        && request.auth.uid == doctorId
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType.matches("video/.*|image/.*");
    }

    match /chats/{chatId}/{allPaths=**} {
      allow read, write: if signedIn() && request.resource.size < 8 * 1024 * 1024;
    }

    match /prescriptions/{doctorId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.auth.uid == doctorId
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType == "application/pdf";
    }
  }
}
