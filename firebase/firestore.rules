rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    // Firestore cannot read .env. Paste the Firebase Auth UID of the single admin
    // (same value as ADMIN_UID in .env.local). Deny-by-default if left as the placeholder.
    function isPlatformAdmin() {
      return signedIn() && request.auth.uid == "REPLACE_WITH_ADMIN_FIREBASE_UID";
    }
    function emailIs(value) {
      return signedIn()
        && request.auth.token.email is string
        && value is string
        && request.auth.token.email.lower() == value.lower();
    }
    function isChatMember(data) {
      return emailIs(data.patientEmail) || emailIs(data.doctorEmail);
    }
    function isParticipant(patientId, doctorId) {
      return signedIn() && (request.auth.uid == patientId || request.auth.uid == doctorId);
    }

    match /doctors_pending_verification/{id} {
      allow create: if request.resource.data.status == "pending";
      allow read, update, delete: if false;
    }

    match /doctors_public/{doctorId} {
      allow read: if true;
      allow create: if signedIn()
        && (request.auth.uid == doctorId || emailIs(request.resource.data.email))
        && request.resource.data.get("isVerified", false) == false;
      allow update: if isPlatformAdmin()
        || (signedIn()
          && (request.auth.uid == doctorId || emailIs(resource.data.email) || emailIs(request.resource.data.email))
          && request.resource.data.get("isVerified", false) == resource.data.get("isVerified", false)
          && (!("pricing" in request.resource.data) || (
            request.resource.data.pricing.onlineFee is number
            && request.resource.data.pricing.onlineFee > 0
            && request.resource.data.pricing.offlineFee is number
            && request.resource.data.pricing.offlineFee > 0
          )));
      allow delete: if isPlatformAdmin();
    }

    match /chats/{chatId} {
      allow read: if isChatMember(resource.data);
      allow create: if signedIn()
        && request.resource.data.appointmentId == chatId
        && request.resource.data.patientId is string
        && request.resource.data.doctorId is string
        && request.resource.data.patientEmail is string
        && request.resource.data.doctorEmail is string
        && isChatMember(request.resource.data);
      allow update: if signedIn()
        && request.resource.data.appointmentId == resource.data.appointmentId
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.doctorId == resource.data.doctorId
        && (isChatMember(resource.data) || isChatMember(request.resource.data));

      match /messages/{messageId} {
        allow read: if isChatMember(
          get(/databases/$(database)/documents/chats/$(chatId)).data
        );
        allow create: if signedIn()
          && isChatMember(get(/databases/$(database)/documents/chats/$(chatId)).data)
          && request.resource.data.senderId is string
          && (
            request.resource.data.senderId == get(/databases/$(database)/documents/chats/$(chatId)).data.patientId
            || request.resource.data.senderId == get(/databases/$(database)/documents/chats/$(chatId)).data.doctorId
          )
          && request.resource.data.type is string;
        allow update, delete: if false;
      }
    }

    match /calls/{roomId} {
      allow get, list: if signedIn() && (
        resource == null
        || isChatMember(resource.data)
      );
      allow create: if signedIn()
        && request.resource.data.patientId is string
        && request.resource.data.doctorId is string
        && request.resource.data.patientEmail is string
        && request.resource.data.doctorEmail is string
        && isChatMember(request.resource.data);
      allow update: if signedIn()
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.doctorId == resource.data.doctorId
        && request.resource.data.patientEmail == resource.data.patientEmail
        && request.resource.data.doctorEmail == resource.data.doctorEmail
        && isChatMember(resource.data);
      allow delete: if isChatMember(resource.data);

      function callParent() {
        return get(/databases/$(database)/documents/calls/$(roomId)).data;
      }

      match /signals/{signalId} {
        allow read: if signedIn() && (
          !exists(/databases/$(database)/documents/calls/$(roomId))
          || isChatMember(callParent())
        );
        allow create: if signedIn()
          && isChatMember(callParent())
          && request.resource.data.from is string
          && request.resource.data.kind in ['offer', 'answer', 'ice', 'hangup', 'missed'];
        allow update, delete: if false;
      }

      match /metadata/{id} {
        allow read, write: if signedIn() && (
          !exists(/databases/$(database)/documents/calls/$(roomId))
          || isChatMember(callParent())
        );
      }
    }

    match /videos/{videoId} {
      allow create: if signedIn()
        && request.resource.data.doctorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.videoUrl is string;
      allow update, delete: if signedIn() && resource.data.doctorId == request.auth.uid;
      allow read: if resource.data.isPublic == true || signedIn();
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId
        || emailIs(resource.data.email)
        || isPlatformAdmin()
      );
      allow create, update: if signedIn() && (
        request.auth.uid == userId
        || emailIs(request.resource.data.email)
      );
      allow delete: if isPlatformAdmin();
    }

    match /daily_logs/{logId} {
      allow create, update: if signedIn()
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.painLevel is int
        && request.resource.data.painLevel >= 1
        && request.resource.data.painLevel <= 10;
      allow read: if signedIn()
        && (request.auth.uid == resource.data.patientId || request.auth.uid == resource.data.doctorId);
      allow delete: if false;
    }

    match /bookings/{bookingId} {
      allow read: if signedIn() && (
        isParticipant(resource.data.patientId, resource.data.physioId)
        || emailIs(resource.data.patientEmail)
        || emailIs(resource.data.doctorEmail)
      );
      allow create: if signedIn()
        && request.resource.data.paymentStatus == "success"
        && (emailIs(request.resource.data.patientEmail) || request.auth.uid == request.resource.data.patientId);
      allow update: if signedIn()
        && (request.auth.uid == resource.data.patientId
          || request.auth.uid == resource.data.physioId
          || emailIs(resource.data.patientEmail)
          || emailIs(resource.data.doctorEmail));
    }

    match /payments/{orderId} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.patientId
        || request.auth.uid == resource.data.doctorId
        || emailIs(resource.data.patientEmail)
      );
      allow create, update: if signedIn()
        && request.resource.data.paymentStatus == "success"
        && (emailIs(request.resource.data.patientEmail) || request.auth.uid == request.resource.data.patientId);
      allow delete: if false;
    }

    match /reminder_dispatches/{id} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /payment_orders/{orderId} {
      allow read, write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && exists(/databases/$(database)/documents/bookings/$(request.resource.data.appointmentId))
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.appointmentId)).data.status == "completed"
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.appointmentId)).data.patientId == request.auth.uid;
      allow update, delete: if false;
    }

    match /prescriptions/{id} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.patientId || request.auth.uid == resource.data.doctorId);
      allow create: if signedIn() && request.resource.data.doctorId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
