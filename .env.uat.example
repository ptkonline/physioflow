# PhysioFlow UAT / Aja testing — Firebase project physioflow-uat, Vercel Preview.
# Copy to the Preview environment. Do not commit real secrets.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=physioflow-uat.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=physioflow-uat
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=physioflow-uat.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Enable Email/Password in Firebase Authentication.
# Sign-in and sign-up are password-only. Leave OTP flags false.

# Do not use local seed passwords on UAT. This flag is documentation only and must stay false.
LOCAL_TEST_ACCOUNTS=false
AUTH_OTP_ENABLED=false
PHONE_OTP_ENABLED=false

# Admin is a separate URL: /admin/login
# ADMIN_UID must be the Firebase Auth UID of the admin user (same account as ADMIN_EMAIL).
ADMIN_EMAIL=
ADMIN_UID=
ADMIN_SESSION_SECRET=
OTP_SECRET=
PAYMENT_SIGNING_SECRET=
FIREBASE_SERVICE_ACCOUNT_JSON=
CRON_SECRET=
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=PhysioFlow <noreply@resend.dev>

NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PAYMENT_PLATFORM_FEE_INR=49
PAYMENT_DEFAULT_FEE_INR=800
NEXT_PUBLIC_PAYMENT_PLATFORM_FEE_INR=49

TURN_URL=
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
